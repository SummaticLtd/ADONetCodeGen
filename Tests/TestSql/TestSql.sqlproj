<Project Sdk="MSBuild.Sdk.SqlProj/4.2.0">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <!-- Sql150 (SQL Server 2019) is the floor for the localdb on GitHub's windows runners.
             A lower target still deploys fine to newer servers, so this works everywhere. -->
        <SqlServerVersion>Sql150</SqlServerVersion>
        <TreatTSqlWarningsAsErrors>True</TreatTSqlWarningsAsErrors>
        <TargetServerName>(localdb)\MSSQLLocalDB</TargetServerName>
        <TargetDatabaseName>ADONetCodeGenTest</TargetDatabaseName>
        <GenerateSmartDefaults>True</GenerateSmartDefaults>
        <DropObjectsNotInSource>True</DropObjectsNotInSource>
        <DropIndexesNotInSource>True</DropIndexesNotInSource>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="**/*.sql" />
    </ItemGroup>

    <!-- Deploy the dacpac to localdb after every build, mirroring the SummaticApp build process. -->
    <Target Name="PublishAfterBuild" AfterTargets="Build">
        <Copy SourceFiles="$(TargetDir)TestSql.dacpac" DestinationFolder="$(ProjectDir)bin/dacpac" />
        <CallTarget Targets="PublishDatabase" />
    </Target>
</Project>
